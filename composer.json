{
    "name": "masmerise/matchmaking-for-laravel",
    "description": "Dynamically pair incoming requests with the right application interface.",
    "license": "MIT",
    "keywords": [
        "laravel",
        "revert"
    ],
    "authors": [
        {
            "name": "Muhammed Sari",
            "email": "support@muhammedsari.me",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/masmerise/matchmaking-for-laravel",
    "require": {
        "php": "~8.5"
    },
    "require-dev": {
        "larastan/larastan": "^3.9.3",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^11.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Masmerise\\Matchmaking\\": "packages/application/src",
            "Masmerise\\Matchmaking\\Utility\\": "packages/utils/src"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "larastan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "verify": "@larastan"
    }
}
